/* ▸ src/modules/dashboard/dashboard.css — đoạn LIÊN TIẾP dòng 538–827 của CSS gốc; thứ tự nạp = thứ tự cascade, KHÔNG đổi thứ tự ◂ */
/* ── DASHBOARD 3 CỘT ── */
/* Mobile: scroll ngang, mỗi cột rộng 82vw */
.dash-3col{display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:4px;margin:0 -12px;padding-left:12px;padding-right:12px}
.dash-3col::-webkit-scrollbar{display:none}
.dash-col{flex:0 0 78vw;min-width:200px;scroll-snap-align:start;display:flex;flex-direction:column;border-radius:14px;overflow:hidden;box-shadow:var(--sh);border:1px solid var(--border)}
.dash-col-hd{display:flex;align-items:center;justify-content:space-between;padding:10px 13px 9px;background:var(--card);border-bottom:1px solid var(--border)}
.dash-col-hd-title{font-size:12.5px;font-weight:700;display:flex;align-items:center;gap:7px}
.dash-col-hd-count{font-size:11px;font-weight:800;padding:2px 8px;border-radius:20px;min-width:24px;text-align:center}
.dash-col-body{background:var(--card);flex:1;overflow:hidden}

/* ── PIPELINE SẢN XUẤT: Đùn → Rút → Cắt → Đánh bóng → Kho ── */
.pipe-wrap{display:flex;align-items:stretch;gap:5px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px}
.pipe-wrap::-webkit-scrollbar{display:none}
.pipe-step{flex:1;min-width:80px;border-radius:12px;padding:10px 6px;text-align:center;border:1.5px solid var(--border);cursor:pointer;transition:transform .12s;background:var(--card)}
.pipe-step:active{transform:scale(.96)}
.pipe-step-ico{font-size:18px;line-height:1}
.pipe-step-num{font-size:20px;font-weight:800;line-height:1.3}
.pipe-step-lbl{font-size:9.5px;font-weight:700;margin-top:1px;color:var(--text3);white-space:nowrap}
.pipe-arrow{align-self:center;font-size:13px;color:var(--text4);flex-shrink:0;padding:0 1px}
.pipe-g{background:var(--green-l);border-color:#B9E4D2}
.pipe-g .pipe-step-lbl{color:#166534}
.pipe-g .pipe-step-num{color:var(--green)}
.pipe-y{background:#FEF9E7;border-color:#fde68a}
.pipe-y .pipe-step-lbl{color:#92400e}
.pipe-y .pipe-step-num{color:#b45309}
.pipe-o{background:#FFF1E6;border-color:#fdba74}
.pipe-o .pipe-step-lbl{color:#9a3412}
.pipe-o .pipe-step-num{color:#c2410c}
.pipe-r{background:#FEECEC;border-color:#fca5a5;animation:warn-pulse 2.4s infinite}
.pipe-r .pipe-step-lbl{color:#991b1b}
.pipe-r .pipe-step-num{color:#dc2626}

/* ── THANH TIẾN ĐỘ LỚN TOÀN NHÀ MÁY ── */
.big-progress{background:var(--card);border-radius:14px;box-shadow:var(--sh);border:1px solid var(--border);padding:11px 13px;margin-bottom:8px;transition:box-shadow .2s,transform .2s}
.big-progress:hover{box-shadow:var(--sh2);transform:translateY(-1px)}
.big-progress-top{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:7px;gap:8px;flex-wrap:wrap}
.big-progress-title{font-size:11.5px;font-weight:800;color:var(--text2);display:flex;align-items:center;gap:5px}
.big-progress-pct{font-size:18px;font-weight:800;color:var(--brand)}
.big-progress-bar{height:9px;border-radius:6px;background:var(--bg);overflow:hidden;box-shadow:inset 0 1px 2px rgba(0,0,0,.06)}
.big-progress-fill{height:100%;border-radius:6px;background:linear-gradient(90deg,var(--brand),var(--green-m));transition:width .7s cubic-bezier(.4,0,.2,1)}
.big-progress-sub{font-size:10.5px;color:var(--text3);margin-top:5px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:5px}

/* ── HÔM NAY CỦA NGƯỜI LAO ĐỘNG ── */
.worker-today{background:linear-gradient(135deg,var(--navy),var(--navy2));border-radius:16px;padding:13px 15px;color:#fff;margin-bottom:10px}
.worker-today-title{font-size:12px;font-weight:800;opacity:.92;margin-bottom:10px;display:flex;align-items:center;gap:6px}
.worker-today-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.worker-today-item{background:rgba(255,255,255,.12);border-radius:10px;padding:9px 6px;text-align:center}
.worker-today-val{font-size:15px;font-weight:800;line-height:1.2}
.worker-today-lbl{font-size:9px;opacity:.9;margin-top:3px}

/* ── NHÂN LỰC HÔM NAY (số người lao động / ca / nghỉ) ── */
@keyframes dashFadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.dash-anim{animation:dashFadeUp .5s cubic-bezier(.16,1,.3,1) both}
.workforce-panel{background:var(--card);border-radius:16px;box-shadow:var(--sh);border:1px solid var(--border);padding:12px 13px;margin-bottom:8px;position:relative;overflow:hidden;transition:box-shadow .2s,transform .2s}
.workforce-panel::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--brand3),#0891b2,var(--green-m))}
.workforce-panel:hover{box-shadow:var(--sh2);transform:translateY(-1px)}
.workforce-panel-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:9px;gap:8px}
.workforce-panel-title{font-size:12px;font-weight:800;color:var(--text2);display:flex;align-items:center;gap:5px}
.workforce-stats-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(78px,1fr));gap:6px;margin-bottom:9px}
.wf-big-stat{background:var(--bg2);border:1px solid var(--border);border-radius:11px;padding:7px 6px;text-align:center;transition:transform .12s}
.wf-big-stat:active{transform:scale(.97)}
.wf-big-stat-val{font-size:17px;font-weight:800;color:var(--text);line-height:1.1}
.wf-big-stat-lbl{font-size:9px;color:var(--text3);font-weight:700;margin-top:3px}
.wf-shift-chips{display:flex;flex-wrap:wrap;gap:5px}
.wf-shift-chip{display:flex;align-items:center;gap:5px;padding:5px 9px;border-radius:20px;font-size:10.5px;font-weight:800;cursor:pointer;transition:transform .12s}
.wf-shift-chip:active{transform:scale(.95)}
.wf-shift-chip-val{background:rgba(255,255,255,.65);border-radius:9px;padding:0 5px;min-width:16px;text-align:center}
.wf-leave-list{margin-top:9px;padding-top:8px;border-top:1px dashed var(--border)}
.wf-leave-list-title{font-size:10.5px;font-weight:800;color:var(--text3);margin-bottom:6px;display:flex;align-items:center;gap:4px}
.wf-leave-row{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:5px 8px;background:#ecfeff;border-radius:8px;margin-bottom:4px;font-size:11.5px}
.wf-leave-row:last-child{margin-bottom:0}
.wf-leave-name{font-weight:700;color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.wf-leave-type{font-size:10px;color:#0e7490;font-weight:700;flex-shrink:0}
.wf-leave-empty{font-size:11px;color:var(--text4);padding:2px 0}

/* ── DANH SÁCH CẢNH BÁO THÔNG MINH ── */
.alert-list{display:flex;flex-direction:column;gap:6px}
.alert-empty{display:flex;align-items:center;gap:8px;padding:10px 12px;border-radius:10px;background:var(--green-l);color:#166534;font-size:12.5px;font-weight:700}
/* AI Warning Badge */
.ai-warn{display:flex;align-items:center;gap:4px;font-size:9.5px;font-weight:700;padding:2px 7px;border-radius:6px;margin-top:3px;width:fit-content}
.ai-warn.red{background:#fef2f2;color:#dc2626;border:1px solid #fca5a5}
.ai-warn.amber{background:#fffbeb;color:#b45309;border:1px solid #fcd34d}
.ai-warn.ok{background:#f0fdf4;color:#16a34a;border:1px solid #86efac}
/* AI warning block trong card — hiện ở mọi tab */
.ai-card-warn{margin:5px 14px 2px;border-radius:8px;overflow:hidden;border:none}
.ai-card-warn-row{display:flex;align-items:flex-start;gap:6px;padding:5px 8px;font-size:11px;font-weight:600;line-height:1.3}
.ai-card-warn-row.critical{background:linear-gradient(135deg,#fef2f2,#fee2e2);color:#991b1b;border:1px solid #fca5a5;border-radius:8px;margin-bottom:3px;animation:warn-pulse 2s infinite}
.ai-card-warn-row.warning{background:linear-gradient(135deg,#fffbeb,#fef3c7);color:#92400e;border:1px solid #fde68a;border-radius:8px;margin-bottom:3px}
.ai-card-warn-row.info{background:linear-gradient(135deg,#eff6ff,#dbeafe);color:#1e40af;border:1px solid #bfdbfe;border-radius:8px;margin-bottom:3px}
.ai-card-warn-ico{font-size:12.5px;flex-shrink:0;margin-top:0}
.ai-card-warn-txt{flex:1}
.ai-card-warn-txt b{font-weight:800}
.ai-card-warn-jump{border-color:#f87171}
.ai-card-warn-jumptag{flex-shrink:0;font-size:8.5px;font-weight:800;background:#dc2626;color:#fff;padding:1px 6px;border-radius:20px;letter-spacing:.2px;white-space:nowrap}
@keyframes warn-pulse{0%,100%{box-shadow:0 0 0 0 rgba(220,38,38,.25)}60%{box-shadow:0 0 0 5px rgba(220,38,38,.0)}}
@keyframes card-flash{0%{box-shadow:0 0 0 0 rgba(37,99,235,.55)}70%{box-shadow:0 0 0 10px rgba(37,99,235,0)}100%{box-shadow:0 0 0 0 rgba(37,99,235,0)}}
.flash-highlight{animation:card-flash 1s ease-out 2}
/* AI Banner */
.ai-banner{background:linear-gradient(135deg,var(--navy),var(--navy2));border-radius:var(--r);padding:12px 14px;color:#fff;margin-bottom:4px}
.ai-banner-title{font-size:12px;font-weight:800;display:flex;align-items:center;gap:6px;margin-bottom:8px;opacity:.9}
.ai-insight{display:flex;align-items:flex-start;gap:8px;padding:5px 0;border-bottom:1px solid rgba(255,255,255,.1)}
.ai-insight:last-child{border-bottom:none;padding-bottom:0}
.ai-insight-icon{font-size:14px;flex-shrink:0;margin-top:1px}
.ai-insight-text{font-size:11.5px;line-height:1.4;opacity:.9}
.ai-insight-text b{color:#60a5fa;opacity:1}
.ai-insight-item{display:flex;gap:8px;padding:7px 10px;border-radius:8px;margin-bottom:4px;font-size:12.5px;line-height:1.4;align-items:flex-start}
.ai-insight-item:last-child{margin-bottom:0}
.ai-insight-item.critical{background:rgba(220,38,38,.15);border:1px solid rgba(220,38,38,.3)}
.ai-insight-item.warning{background:rgba(245,158,11,.12);border:1px solid rgba(245,158,11,.3)}
.ai-insight-item.info{background:rgba(59,130,246,.1);border:1px solid rgba(59,130,246,.25)}
.ai-insight-item.ok{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.25)}
.ai-insight-ico{font-size:15px;flex-shrink:0;margin-top:1px}
.ai-insight-txt{flex:1;color:#e2e8f0}
.ai-insight-txt b{color:#fff;font-weight:700}
.new-card{padding:10px 13px;border-bottom:1px solid var(--border);position:relative}
.new-card:last-child{border-bottom:none}
.new-card-top{display:flex;align-items:center;gap:6px;margin-bottom:4px}
.new-card-cust{font-size:13.5px;font-weight:800;color:var(--text);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.new-card-spec{font-size:11px;color:var(--text2);margin-bottom:3px}
.new-card-row{display:flex;gap:5px;flex-wrap:wrap;align-items:center}
.new-card-chip{font-size:10.5px;padding:1px 7px;border-radius:5px;font-weight:600;background:var(--bg);border:1px solid var(--border);color:var(--text3)}
.new-card-chip.kg{background:#f0fdf4;border-color:#86efac;color:#166534}
.new-card-chip.pri{font-weight:800}
.new-card-time{font-size:10px;color:var(--text4);margin-top:4px}
/* Desktop: 4 cột */
.dash-mini-card{padding:9px 13px;border-bottom:1px solid var(--border);cursor:pointer;transition:background .1s;position:relative}
.dash-mini-card:last-child{border-bottom:none}
.dash-mini-card:active{background:var(--bg)}
.dash-mini-cust{font-size:13px;font-weight:700;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:3px}
.dash-mini-spec{font-size:11px;color:var(--text3);line-height:1.4}
.dash-mini-row{display:flex;align-items:center;gap:5px;flex-wrap:wrap;margin-top:3px}
.dash-mini-time{font-size:10.5px;color:var(--text4);margin-top:3px}
.dash-empty{padding:24px 16px;text-align:center;color:var(--text4);font-size:12px;background:var(--card)}

/* ── DASHBOARD ANALYTICS (charts) ── */
.dash-analytics-grid{display:grid;grid-template-columns:1fr;gap:10px}
.chart-card{background:var(--card);border-radius:16px;box-shadow:var(--sh);border:1px solid var(--border);padding:14px;transition:box-shadow .2s,transform .2s}
.chart-card:hover{box-shadow:var(--sh2);transform:translateY(-1px)}
.chart-card-title{font-size:12.5px;font-weight:800;color:var(--text2);display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:12px}
.chart-card-title-txt{display:flex;align-items:center;gap:6px}
.chart-card-sub{font-size:10.5px;color:var(--text4);font-weight:700;background:var(--bg);padding:2px 8px;border-radius:20px;white-space:nowrap}
.donut-wrap{position:relative;flex-shrink:0;width:112px;height:112px}
.donut-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none}
.donut-center-val{font-size:21px;font-weight:800;color:var(--text);line-height:1}
.donut-center-lbl{font-size:8.5px;color:var(--text4);font-weight:700;letter-spacing:.4px;margin-top:2px}
.chart-legend{flex:1;display:flex;flex-direction:column;gap:7px;min-width:0}
.chart-legend-row{display:flex;align-items:center;gap:7px;font-size:11.5px}
.chart-legend-dot{width:9px;height:9px;border-radius:3px;flex-shrink:0}
.chart-legend-lbl{flex:1;color:var(--text2);font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chart-legend-val{font-weight:800;color:var(--text)}
.chart-legend-pct{font-size:10px;color:var(--text4);font-weight:600;min-width:32px;text-align:right}
.hbar-row{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.hbar-row:last-child{margin-bottom:0}
.hbar-lbl{width:52px;font-size:10.5px;font-weight:700;color:var(--text3);flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hbar-track{flex:1;height:15px;background:var(--bg);border-radius:8px;overflow:hidden;position:relative}
.hbar-fill{height:100%;border-radius:8px;transition:width .4s cubic-bezier(.4,0,.2,1)}
.hbar-val{width:34px;font-size:11px;font-weight:800;color:var(--text2);text-align:right;flex-shrink:0}
.trend-chart-wrap{width:100%}
.chart-empty-mini{padding:16px 8px;text-align:center;color:var(--text4);font-size:11.5px}
/* ── Chart hover/tap tooltip ── */
.chart-tip{position:fixed;z-index:9999;display:none;background:var(--navy);color:#fff;font-size:11.5px;font-weight:600;line-height:1.4;padding:7px 10px;border-radius:8px;box-shadow:0 6px 20px rgba(0,0,0,.25);pointer-events:none;max-width:200px;white-space:nowrap}
.chart-tip b{font-weight:800;color:#93c5fd}
.hbar-row{cursor:pointer}
.hbar-track{cursor:pointer}
.donut-wrap svg circle{cursor:pointer;transition:opacity .15s}
.donut-wrap svg circle:hover{opacity:.82}
.trend-dot{cursor:pointer}
/* ── Highlight khi nhảy tới đơn từ Dashboard ── */
@keyframes orderJumpPulse{
  0%{box-shadow:0 0 0 0 rgba(37,99,235,.55);}
  70%{box-shadow:0 0 0 12px rgba(37,99,235,0);}
  100%{box-shadow:0 0 0 0 rgba(37,99,235,0);}
}
.order-jump-highlight{animation:orderJumpPulse 1s ease-out 2;outline:2px solid #2563eb;outline-offset:2px;border-radius:12px}
.new-card{cursor:pointer;transition:transform .12s,box-shadow .12s}
.new-card:active{transform:scale(.98)}
@media(min-width:700px){
  .dash-analytics-grid{grid-template-columns:1fr 1fr;gap:12px}
  .chart-card{padding:16px 18px}
  .donut-wrap{width:128px;height:128px}
  .donut-center-val{font-size:24px}
}

/* ── SECTION TITLE ── */
.sec-title{font-size:12px;font-weight:800;color:var(--brand2);text-transform:uppercase;letter-spacing:.6px;padding:5px 0 5px 11px;position:relative}
.sec-title::before{content:'';position:absolute;left:0;top:3px;bottom:3px;width:4px;border-radius:3px;background:linear-gradient(180deg,var(--brand3),var(--purple-m))}

/* ── SEARCH BAR ── */
.search-wrap{position:relative}
.search-wrap svg{position:absolute;left:11px;top:50%;transform:translateY(-50%);width:16px;height:16px;stroke:var(--text4);stroke-width:2}
.search-inp{width:100%;padding:10px 36px 10px 34px;border:1.5px solid var(--border);border-radius:var(--r-sm);font-size:13.5px;font-family:inherit;outline:none;background:#fff;color:var(--text)}
.search-inp:focus{border-color:var(--brand2);box-shadow:0 0 0 3px rgba(37,99,235,.08)}

/* ── FILTER CHIPS ── */
.chips{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px}
.chips::-webkit-scrollbar{display:none}
.chip{padding:6px 13px;border-radius:20px;border:1.5px solid var(--border);font-size:12.5px;font-weight:600;font-family:inherit;cursor:pointer;background:#fff;color:var(--text3);white-space:nowrap;transition:all .12s;flex-shrink:0}
.chip.active{background:var(--brand);color:#fff;border-color:var(--brand)}
.chip.chip-done{border-color:#86efac;background:var(--green-l);color:var(--green)}
.chip.chip-done:active{transform:scale(.96)}

/* ── STICKY TOOLBAR (tab đơn dở dang) ── */
.dd-toolbar{position:sticky;top:-12px;z-index:15;background:var(--bg);margin:-12px -12px 10px;padding:12px 12px 8px;display:flex;flex-direction:column;gap:8px;border-bottom:1px solid var(--border)}
@media(min-width:700px){.dd-toolbar{margin:-20px -24px 14px;padding:20px 24px 10px}}

/* ── KẾ HOẠCH SUMMARY ── */
.kh-summary{display:grid;grid-template-columns:repeat(3,1fr);background:var(--card);border-radius:var(--r);box-shadow:var(--sh);overflow:hidden}
.kh-sum{display:flex;flex-direction:column;align-items:center;padding:14px 8px;gap:3px;cursor:pointer;border:none;background:none;font-family:inherit;transition:background .15s,transform .12s;flex:1;text-align:center;position:relative}
.kh-sum::after{content:'';position:absolute;left:14%;right:14%;bottom:0;height:3px;border-radius:3px 3px 0 0;background:transparent;transition:background .15s}
.kh-sum:hover{background:var(--bg)}
.kh-sum:active{transform:scale(.97)}
.kh-sum + .kh-sum{border-left:1px solid var(--border)}
.kh-sum-n{font-size:26px;font-weight:800;line-height:1}
.kh-sum-l{font-size:10.5px;color:var(--text3);font-weight:600;letter-spacing:.1px}
.wait-c{color:var(--amber-m)}.run-c{color:var(--brand3)}.done-c{color:var(--green-m)}
.kh-sec-hd{display:flex;align-items:center;gap:8px;padding:9px 12px;border-radius:var(--r-sm);margin:4px 0 8px;box-shadow:var(--sh)}
.kh-sec-hd span:first-child{font-size:13.5px;font-weight:800;letter-spacing:-.1px}
.kh-count{background:rgba(255,255,255,.75);color:var(--text2);font-size:11px;font-weight:800;padding:2px 9px;border-radius:20px;margin-left:auto;border:1.5px solid rgba(0,0,0,.08);box-shadow:var(--sh)}
.kh-sec-hd.type-run{background:linear-gradient(135deg,#eff6ff,#dbeafe);border-left:4px solid var(--brand3)}
.kh-sec-hd.type-run span:first-child{color:var(--brand2)}
.kh-sec-hd.type-wait{background:linear-gradient(135deg,#fffbeb,#fef3c7);border-left:4px solid var(--amber-m)}
.kh-sec-hd.type-wait span:first-child{color:var(--amber)}
.kh-sec-hd.type-done{background:linear-gradient(135deg,#f0fdf4,#dcfce7);border-left:4px solid var(--green-m)}
.kh-sec-hd.type-done span:first-child{color:var(--green)}

/* ── ACTIVITY LOG ── */
.act-row{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid var(--border);align-items:flex-start}
.act-row:last-child{border-bottom:none}
.act-icon-wrap{width:34px;height:34px;border-radius:50%;background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0}
.act-body{flex:1;min-width:0}
.act-main{font-size:13px;color:var(--text);font-weight:600}
.act-detail{font-size:12px;color:var(--text3);margin-top:2px}
.act-meta{font-size:11px;color:var(--text4);margin-top:3px}
.act-oid{font-size:10.5px;color:var(--brand3);font-family:monospace;margin-top:2px}

/* ── ONLINE STRIP (Dashboard, gọn) ── */
.online-strip{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--border);border-radius:var(--r-sm);padding:9px 12px;cursor:pointer;transition:border-color .12s,box-shadow .12s;user-select:none}
.online-strip:hover{border-color:#86efac;box-shadow:0 1px 4px rgba(22,101,52,.08)}
.online-strip-left{display:flex;align-items:center;gap:7px;flex-shrink:0}
.online-strip-label{font-size:12.5px;font-weight:700;color:var(--text2)}
.online-strip-count{font-size:11px;font-weight:800;background:#dcfce7;color:#166534;padding:1px 7px;border-radius:20px}
.online-strip-breakdown{font-size:10px;font-weight:700;color:var(--text4);display:none}
@media(min-width:520px){.online-strip-breakdown{display:inline}}
.online-avatar-stack{display:flex;margin-left:auto;padding-right:2px}
.online-avatar-sm{width:26px;height:26px;border-radius:50%;background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;border:2px solid #fff;margin-left:-8px;flex-shrink:0;overflow:hidden}
.online-avatar-sm:first-child{margin-left:0}
.online-avatar-more{background:var(--bg);color:var(--text3)}
.online-strip-chevron{width:15px;height:15px;stroke:var(--text4);stroke-width:2.2;transition:transform .15s;flex-shrink:0}
.online-strip-chevron.open{transform:rotate(180deg)}
.online-detail{margin-top:6px;display:flex;flex-direction:column;gap:5px;animation:onlineDetailIn .12s ease-out}
@keyframes onlineDetailIn{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}

/* ── ONLINE BAR ── */
.online-bar{display:flex;flex-direction:column;gap:8px;background:#f0fdf4;border:1px solid #86efac;border-radius:var(--r-sm);padding:10px 12px}
.online-bar-hd{display:flex;align-items:center;gap:6px}
.online-dot{width:8px;height:8px;border-radius:50%;background:var(--green-m);flex-shrink:0;animation:pulse 1.5s infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.6;transform:scale(.8)}}
.online-list{display:flex;flex-direction:column;gap:6px}
/* Mỗi dòng người dùng: gọn 1 hàng, đầy đủ vai trò + trang đang xem +
   thiết bị + thời lượng online — hàng của chính mình được viền xanh brand
   để dễ nhận ra ngay trong danh sách. */
.online-row{display:flex;align-items:center;gap:8px;background:#fff;border:1px solid #86efac;border-radius:9px;padding:6px 9px}
.online-row.me{border-color:var(--brand3);background:#f8fbff}
.online-avatar{width:28px;height:28px;border-radius:50%;color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;position:relative;overflow:hidden}
.online-avatar::after{content:'';position:absolute;bottom:-1px;right:-1px;width:8px;height:8px;border-radius:50%;background:var(--green-m);border:2px solid #fff}
.online-row-body{min-width:0;flex:1}
.online-row-name{font-size:12.5px;font-weight:700;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.online-row-me{font-size:8.5px;font-weight:800;background:#dbeafe;color:var(--brand);padding:0 5px;border-radius:8px;vertical-align:middle}
.online-row-meta{font-size:10px;color:var(--text3);display:flex;align-items:center;gap:4px;flex-wrap:wrap;margin-top:2px}
.online-row-role{font-size:9.5px;font-weight:700;padding:1px 7px;border-radius:20px;flex-shrink:0}
.online-row-tag{font-size:9.5px;font-weight:600;color:var(--text3);white-space:nowrap}
.online-row-right{flex-shrink:0}
.online-row-dur{font-size:9.5px;font-weight:700;color:var(--brand3);background:#eff6ff;padding:2px 8px;border-radius:20px;white-space:nowrap}
/* legacy chip kept for compatibility */
.online-chip{font-size:11.5px;background:#fff;color:#166534;border:1px solid #86efac;padding:2px 8px;border-radius:20px;font-weight:600}

/* ── SIDEBAR ONLINE PANEL ── */
.sb-online-hd{display:flex;align-items:center;justify-content:space-between;gap:6px;font-weight:700;color:#166534;margin-bottom:6px;font-size:11.5px}
.sb-online-breakdown{font-weight:700;color:var(--text3);font-size:10px}
.sb-online-me{font-size:8.5px;font-weight:800;background:#dbeafe;color:var(--brand);padding:0 5px;border-radius:8px;vertical-align:middle}
.sb-online-offline{font-size:11px;font-weight:600;color:var(--amber-m);background:var(--amber-l);border-radius:8px;padding:6px 8px;line-height:1.4}
.sb-online-list{display:flex;flex-direction:column;gap:4px}
.sb-online-row{display:flex;align-items:center;gap:7px;padding:4px 2px}
.sb-online-avatar{width:22px;height:22px;border-radius:50%;background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;font-size:9.5px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;position:relative;overflow:hidden}
.online-avatar-sm img,.online-avatar img,.sb-online-avatar img,.dh3-tb-account-av img{width:100%;height:100%;object-fit:cover;border-radius:50%}
.sb-online-avatar::after{content:'';position:absolute;bottom:-1px;right:-1px;width:7px;height:7px;border-radius:50%;background:var(--green-m);border:1.5px solid #fff}
.sb-online-body{min-width:0;flex:1}
.sb-online-name{font-size:11.5px;font-weight:700;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sb-online-tab{font-size:10px;color:var(--text4);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

